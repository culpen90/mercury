{
  "name": "mercury-rambler-beta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "dev": "wrangler dev --local"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "miniflare": "5.20261019.2-beta",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
